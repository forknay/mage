[node name="Chest" type="Node3D"]
script = ExtResource("2_chest")

; Rotated -90 degrees on Y so the lock face points down -Z, Godot's forward, the
; same convention the torch uses. Scaled to 0.9 and offset so the centre of the
; chest's base sits at the scene origin, which puts it on the floor when the
; node's Y is the floor height.
[node name="Model" parent="." instance=ExtResource("1_chest")]
transform = Transform3D(0, 0, 0.9, 0, 0.9, 0, -0.9, 0, 0, 0.1328, 0.215, -0.0134)

; On the world layer so the player, whose mask covers world and enemies, walks
; into it. The chest never needs to detect anything itself, hence mask 0.
[node name="Body" type="StaticBody3D" parent="."]
collision_layer = 1
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.29, 0)
shape = SubResource("BoxShape3D_chest")
